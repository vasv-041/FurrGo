# =============================================================================
# Healthcare Monitoring Assistant — .env.example
# Copy this file to .env and fill in the values for your environment.
# =============================================================================
#
# NEVER put real secrets in this file.
# This file IS committed to version control as a reference template.
# =============================================================================

# --------------------------------------------------------------------------- #
# Application metadata
# --------------------------------------------------------------------------- #
APP_NAME="Healthcare Monitoring Assistant"
APP_VERSION="0.1.0"
DEBUG=False

# --------------------------------------------------------------------------- #
# Server settings
# --------------------------------------------------------------------------- #
HOST=127.0.0.1
PORT=8000

# --------------------------------------------------------------------------- #
# Phase 2 — AI / LLM integration (Gemini for image/PDF — later phase)
# Obtain a free key at: https://aistudio.google.com/app/apikey
# --------------------------------------------------------------------------- #
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# --------------------------------------------------------------------------- #
# Phase 3 — NVIDIA Nemotron (text-only chat)
# Obtain a free key at: https://build.nvidia.com/explore/discover
# --------------------------------------------------------------------------- #
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --------------------------------------------------------------------------- #
# Phase 3 — Database
# SQLite (local file) is the default. Update for PostgreSQL in production.
# --------------------------------------------------------------------------- #
DATABASE_URL=sqlite:///./data/health_ai.db

# --------------------------------------------------------------------------- #
# Phase 4 — File uploads
# --------------------------------------------------------------------------- #
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# --------------------------------------------------------------------------- #
# Phase 5 — External health integrations (e.g., Google Fit, Apple Health)
# --------------------------------------------------------------------------- #
HEALTH_INTEGRATION_API_KEY=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
